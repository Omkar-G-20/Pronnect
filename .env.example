# Environment variables — copy to .env.local and fill in values

# Database
DATABASE_URL="postgresql://pronnect:pronnect_secret@localhost:5432/pronnect"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production-min-32-chars"

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Project settings encryption (AES-256 key derivation)
ENCRYPTION_SECRET="your-32-char-encryption-secret!!"

# Uploadthing (file storage) — get keys at https://uploadthing.com
UPLOADTHING_TOKEN=""

# Redis (for rate limiting)
REDIS_URL="redis://localhost:6379"
